{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content_ig.js" ],
      "matches": [ "https://www.instagram.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "content_tt.js" ],
      "matches": [ "https://www.tiktok.com/*" ],
      "run_at": "document_idle"
   } ],
   "description": "Add creators to Agency 8 master lists from Instagram and TikTok",
   "host_permissions": [ "https://www.instagram.com/*", "https://www.tiktok.com/*", "https://sheets.googleapis.com/*", "*://*/*" ],
   "key": "",
   "manifest_version": 3,
   "name": "Agency 8 — Creator Add",
   "options_page": "options.html",
   "permissions": [ "storage", "identity", "activeTab", "tabs", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.5"
}
